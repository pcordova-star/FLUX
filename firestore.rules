rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    // Cache user data for subsequent rule evaluations in the same request
    function getUserData(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data;
    }

    function isSuperAdmin() {
      // Use let to avoid re-evaluation
      let userData = getUserData(request.auth.uid);
      return isSignedIn() && userData.role == 'super_admin';
    }

    function isAdmin() {
      let userData = getUserData(request.auth.uid);
      return isSignedIn() && (userData.role == 'admin' || userData.role == 'super_admin');
    }

    function isSameCompanyAsUser(companyId) {
      return isSignedIn() && getUserData(request.auth.uid).companyId == companyId;
    }
    
    function isClientViewerForClient(clientId) {
      let userData = getUserData(request.auth.uid);
      return isSignedIn() && 
             userData.role == 'client_viewer' && 
             userData.clientId == clientId;
    }
    
    function isWarehouseOperatorForWarehouse(warehouseId) {
      let userData = getUserData(request.auth.uid);
      return isSignedIn() && 
             userData.role == 'warehouse_operator' && 
             'warehouseIds' in userData &&
             userData.warehouseIds is list && 
             warehouseId in userData.warehouseIds;
    }
    
    // --- Collection Rules ---

    // Users: Admins can manage users within their own company. Users can read their own profile.
    match /users/{userId} {
      allow get: if isSignedIn() && (
        request.auth.uid == userId ||
        (isAdmin() && isSameCompanyAsUser(resource.data.companyId))
      );
      allow list: if isAdmin() && isSameCompanyAsUser(request.query.companyId);
      allow create: if isAdmin() && isSameCompanyAsUser(request.resource.data.companyId);
      allow update: if isAdmin() && 
                      isSameCompanyAsUser(request.resource.data.companyId) &&
                      // Prevent an admin from promoting/demoting themselves or changing role to super_admin
                      !(request.auth.uid == userId && request.resource.data.role != resource.data.role);
      allow delete: if false; // Use `isActive` flag for soft deletes.
    }

    // Companies: Only Super Admins can manage companies. Admins can read their own company doc.
    match /companies/{companyId} {
      allow get: if isSameCompanyAsUser(companyId);
      allow list: if isSuperAdmin(); // Super admins may need to list companies.
      allow write: if isSuperAdmin();
    }
    
    // Clients: Admins manage clients. Assigned client viewers can view their specific client.
    match /clients/{clientId} {
       allow get: if isSameCompanyAsUser(resource.data.companyId) || isClientViewerForClient(clientId);
       allow list: if isAdmin() && isSameCompanyAsUser(request.query.companyId);
       allow write: if isAdmin() && isSameCompanyAsUser(request.resource.data.companyId);
    }

    // Warehouses: Admins manage warehouses. Assigned operators can view their assigned warehouses.
    match /warehouses/{warehouseId} {
      allow get: if isSameCompanyAsUser(resource.data.companyId) || isWarehouseOperatorForWarehouse(warehouseId);
      allow list: if isAdmin() && isSameCompanyAsUser(request.query.companyId);
      allow write: if isAdmin() && isSameCompanyAsUser(request.resource.data.companyId);
    }
    
    // Products: Admins manage products. All company members can view them.
    match /products/{productId} {
      allow get: if isSameCompanyAsUser(resource.data.companyId);
      allow list: if isSameCompanyAsUser(request.query.companyId); // Query must filter by companyId
      allow write: if isAdmin() && isSameCompanyAsUser(request.resource.data.companyId);
    }

    // Orders: Granular access for different roles.
    match /orders/{orderId} {
      allow get: if isSameCompanyAsUser(resource.data.companyId) || isClientViewerForClient(resource.data.clientId);
      allow list: if 
        (isAdmin() && isSameCompanyAsUser(request.query.companyId)) ||
        (isClientViewerForClient(request.query.clientId) && request.query.companyId == getUserData(request.auth.uid).companyId);
      allow create: if 
        (isAdmin() && isSameCompanyAsUser(request.resource.data.companyId)) ||
        (isWarehouseOperatorForWarehouse(request.resource.data.warehouseId) && isSameCompanyAsUser(request.resource.data.companyId));
      allow update: if
        (isAdmin() && isSameCompanyAsUser(request.resource.data.companyId)) ||
        (
          isWarehouseOperatorForWarehouse(request.resource.data.warehouseId) &&
          isSameCompanyAsUser(request.resource.data.companyId) &&
          // Critical fields cannot be changed on update by operator
          request.resource.data.companyId == resource.data.companyId &&
          request.resource.data.clientId == resource.data.clientId
        );
      allow delete: if false;
      
      // Order Events: Inherit permissions from parent order.
      match /events/{eventId} {
        allow read: if isSameCompanyAsUser(get(/databases/$(database)/documents/orders/$(orderId)).data.companyId) || 
                       isClientViewerForClient(get(/databases/$(database)/documents/orders/$(orderId)).data.clientId);
        allow create: if 
            isSameCompanyAsUser(request.resource.data.companyId) &&
            (isAdmin() || isWarehouseOperatorForWarehouse(get(/databases/$(database)/documents/orders/$(orderId)).data.warehouseId)) &&
            request.resource.data.companyId == get(/databases/$(database)/documents/orders/$(orderId)).data.companyId; // Ensure event companyId matches order companyId
        allow update, delete: if false;
      }
    }
    
    // Inventory Balances & Ledger: Admins or assigned operators can manage.
    match /inventory_balances/{balanceId} {
      allow get: if isSameCompanyAsUser(resource.data.companyId) || isWarehouseOperatorForWarehouse(resource.data.warehouseId);
      allow list: if (isAdmin() && isSameCompanyAsUser(request.query.companyId)) ||
                     (isWarehouseOperatorForWarehouse(request.query.warehouseId) && request.query.companyId == getUserData(request.auth.uid).companyId);
      allow create, update: if 
        (isAdmin() && isSameCompanyAsUser(request.resource.data.companyId)) ||
        (isWarehouseOperatorForWarehouse(request.resource.data.warehouseId) && isSameCompanyAsUser(request.resource.data.companyId));
      allow delete: if false;
    }
    
    match /inventory_ledger/{ledgerId} {
      allow get: if isSameCompanyAsUser(resource.data.companyId) || isWarehouseOperatorForWarehouse(resource.data.warehouseId);
      allow list: if (isAdmin() && isSameCompanyAsUser(request.query.companyId)) ||
                     (isWarehouseOperatorForWarehouse(request.query.warehouseId) && request.query.companyId == getUserData(request.auth.uid).companyId);
      allow create: if 
        (isAdmin() && isSameCompanyAsUser(request.resource.data.companyId)) ||
        (isWarehouseOperatorForWarehouse(request.resource.data.warehouseId) && isSameCompanyAsUser(request.resource.data.companyId));
      allow update, delete: if false;
    }
  }
}
