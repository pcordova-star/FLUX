rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isSuperAdmin() {
      return isSignedIn() && getUserData().role == 'super_admin';
    }

    function isAdmin() {
      let userRole = getUserData().role;
      return isSignedIn() && (userRole == 'admin' || isSuperAdmin());
    }

    function isOperator() {
      let userRole = getUserData().role;
      return isSignedIn() && (userRole == 'operator' || isAdmin());
    }
    
    function isSameCompany(companyId) {
       return isSignedIn() && getUserData().companyId == companyId;
    }
    
    // --- Base Rules ---
    
    match /users/{userId} {
      // Any authenticated user can create their own user document.
      allow create: if isOwner(userId);

      // An admin can read any user within their own company.
      // A regular user can only read their own profile.
      allow read: if isAdmin() && isSameCompany(get(/databases/$(database)/documents/users/$(userId)).data.companyId)
                  || isOwner(userId);
                          
      // A user can update their own profile, but CANNOT change their role or companyId.
      // An admin can update any user in their company, including changing their role.
      allow update: if isOwner(userId) && 
                      !(request.resource.data.role != resource.data.role ||
                        request.resource.data.companyId != resource.data.companyId)
                    ||
                    (isAdmin() && isSameCompany(get(/databases/$(database)/documents/users/$(userId)).data.companyId));
                     
      allow delete: if false; 
    }
    
    match /seed_log/{logId} {
       allow read, create: if isSuperAdmin();
    }
    
    match /health/{docId} {
       allow read: if isSignedIn();
    }

    // --- Business Logic Rules ---

    match /companies/{companyId} {
      allow read, write: if isAdmin() && isSameCompany(companyId);
      allow list: if isSuperAdmin();
    }

    // Orders collection
    match /orders/{orderId} {
      // Any authenticated user of the company can view an order.
      allow get: if isSameCompany(resource.data.companyId);
      // Any authenticated user can list orders for their company.
      allow list: if request.query.companyId == getUserData().companyId;
      // Admins and Operators can create and update orders.
      allow create, update: if isOperator() && isSameCompany(request.resource.data.companyId);
      // Only admins can delete orders.
      allow delete: if isAdmin() && isSameCompany(resource.data.companyId);
    }
    
    // Order events are append-only.
    match /orders/{orderId}/events/{eventId} {
       // Any authenticated user of the company can read events.
       allow read: if get(/databases/$(database)/documents/orders/$(orderId)).data.companyId == getUserData().companyId;
       // Operators and Admins can create events (e.g., by changing order status).
       allow create: if isOperator() && request.resource.data.companyId == getUserData().companyId;
       // Events are immutable.
       allow update, delete: if false;
    }
    
    // Inventory Balances
    match /inventory_balances/{balanceId} {
      // Anyone in the company can read inventory balances.
      allow get: if isSameCompany(resource.data.companyId);
      allow list: if request.query.companyId == getUserData().companyId;
      // Writes are only allowed for admins/operators (via transactions).
      allow write: if isOperator() && isSameCompany(request.resource.data.companyId);
      allow delete: if false; // Deny direct deletions.
    }

    // Inventory Ledger is append-only for operators.
    match /inventory_ledger/{ledgerId} {
       // Anyone in the company can read the ledger.
       allow get, list: if isSameCompany(resource.data.companyId);
       // Only operators and admins can create ledger entries (via transactions).
       allow create: if isOperator() && isSameCompany(request.resource.data.companyId);
       // The ledger is immutable. Deny any modification or deletion.
       allow update, delete: if false;
    }
    
    // Products, Warehouses, Clients
    match /{collection}/{docId} {
       // Admins can manage core resources of their company.
       allow write: if collection in ['clients', 'warehouses', 'products']
                           && isAdmin()
                           && isSameCompany(request.resource.data.companyId); 
                           
       // Any authenticated user in the company can read these resources.
       allow get: if collection in ['clients', 'warehouses', 'products']
                  && isSameCompany(resource.data.companyId);
                  
       // Users can LIST resources ONLY if they are querying by their own companyId.
       allow list: if collection in ['clients', 'warehouses', 'products']
                   && request.query.companyId == getUserData().companyId;
    }
  }
}
