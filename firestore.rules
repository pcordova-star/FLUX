rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function getUserData() {
      // It's more efficient to read the user's own data once per request.
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isSuperAdmin() {
      return isSignedIn() && getUserData().role == 'super_admin';
    }

    function isAdmin() {
      let userRole = getUserData().role;
      return isSignedIn() && (userRole == 'admin' || userRole == 'super_admin');
    }
    
    function isSameCompany(companyId) {
       return isSignedIn() && getUserData().companyId == companyId;
    }

    // --- Base Rules ---
    
    // Users can create, read, and update their OWN user document. No one else can.
    match /users/{userId} {
      allow create: if isOwner(userId);
      allow read, update: if isOwner(userId);
      allow delete: if false; // Soft deletes should be handled via an 'isActive' flag
    }
    
    match /seed_log/{logId} {
       allow read, create: if isSignedIn();
    }
    
    match /health/{docId} {
       allow read: if isSignedIn();
    }

    // --- Business Logic Rules ---

    // Admins and super-admins can manage their own company's document.
    match /companies/{companyId} {
      // Admins/Super-Admins can read/write their own company doc.
      allow read, write: if isAdmin() && isSameCompany(companyId);
      // Super-admins can list all companies.
      allow list: if isSuperAdmin();
    }
    
    // Generic rule for all company-scoped collections
    match /{collection}/{docId} {
       // An admin can write to any resource within their own company.
       allow write: if collection in ['clients', 'warehouses', 'products', 'inventory_balances', 'inventory_ledger', 'orders']
                           && isAdmin()
                           && isSameCompany(request.resource.data.companyId); 
                           
       // Any authenticated user can read a single document belonging to their company.
       allow get: if collection in ['clients', 'warehouses', 'products', 'inventory_balances', 'inventory_ledger', 'orders']
                  && isSameCompany(resource.data.companyId);

       // Users can LIST resources ONLY if they are querying by their own companyId.
       // This is the key rule for secure, multi-tenant list queries.
       allow list: if collection in ['clients', 'warehouses', 'products', 'inventory_balances', 'inventory_ledger', 'orders']
                   && request.query.companyId == getUserData().companyId;
    }
    
    // Special rules for order events.
    match /orders/{orderId}/events/{eventId} {
       // Allow reading events if the parent order belongs to the user's company.
       allow read: if get(/databases/$(database)/documents/orders/$(orderId)).data.companyId == getUserData().companyId;
       // Allow creating events if the event data includes the correct companyId.
       allow create: if request.resource.data.companyId == getUserData().companyId;
       // Prevent modification of historical events.
       allow update, delete: if false;
    }
  }
}
