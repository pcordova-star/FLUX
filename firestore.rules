rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- Base Rules ---
    
    // Users can create, read, and update their OWN user document. No one else can.
    match /users/{userId} {
      allow create: if isOwner(userId);
      allow read, update: if isOwner(userId);
      allow delete: if false; // Soft deletes should be handled via an 'isActive' flag
    }
    
    // Log for seeding actions. Should ideally be super-admin only, but let's keep it open for authed users for dev.
    match /seed_log/{logId} {
       allow read, create: if isSignedIn();
    }
    
    // Health check document for diagnostics.
    match /health/{docId} {
       allow read: if isSignedIn();
    }

    // --- Business Logic Rules ---
    // The rules below depend on the user's role and company, stored in /users/{uid}
    
    function getUserData() {
      // It's more efficient to read the user's own data once per request.
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isSuperAdmin() {
      return isSignedIn() && getUserData().role == 'super_admin';
    }

    function isAdmin() {
      let userRole = getUserData().role;
      return isSignedIn() && (userRole == 'admin' || userRole == 'super_admin');
    }
    
    function isSameCompany(companyId) {
       return isSignedIn() && getUserData().companyId == companyId;
    }

    // --- Collection Rules ---

    // Admins and super-admins can manage their own company's document.
    match /companies/{companyId} {
      allow read, write: if isAdmin() && isSameCompany(companyId);
      // Super-admins might need to list all companies.
      allow list: if isSuperAdmin();
    }
    
    // A generic rule for company-scoped resources.
    // This can be applied to clients, warehouses, products, etc.
    match /{collection}/{docId} {
       // An admin can do anything within their own company.
       allow read, write: if collection in ['clients', 'warehouses', 'products', 'inventory_balances', 'inventory_ledger', 'orders']
                           && isAdmin()
                           && isSameCompany(request.resource.data.companyId); // For writes
                           
       // Non-admins can read resources of their own company.
       allow get: if collection in ['clients', 'warehouses', 'products', 'inventory_balances', 'inventory_ledger', 'orders']
                  && isSameCompany(resource.data.companyId);

       // Users can list resources if they filter by their companyId.
       allow list: if collection in ['clients', 'warehouses', 'products', 'inventory_balances', 'inventory_ledger', 'orders']
                   && request.query.companyId == getUserData().companyId;
    }
    
    // Special rules for order events.
    match /orders/{orderId}/events/{eventId} {
       allow read: if get(/databases/$(database)/documents/orders/$(orderId)).data.companyId == getUserData().companyId;
       allow create: if request.resource.data.companyId == getUserData().companyId;
       allow update, delete: if false;
    }
  }
}
