rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data;
    }

    function isSuperAdmin(userId) {
      let userData = getUserData(userId);
      return isSignedIn() && userData.role == 'super_admin';
    }

    function isAdmin(userId) {
      let userRole = getUserData(userId).role;
      return isSignedIn() && (userRole == 'admin' || userRole == 'super_admin');
    }

    function isSameCompanyAsUser(companyId) {
      return isSignedIn() && getUserData(request.auth.uid).companyId == companyId;
    }

    function isClientViewerForClient(clientId) {
      let userData = getUserData(request.auth.uid);
      return isSignedIn() && userData.role == 'client_viewer' && userData.clientId == clientId;
    }
    
    function isWarehouseOperatorForWarehouse(warehouseId) {
      let userData = getUserData(request.auth.uid);
      return isSignedIn() && 
             userData.role == 'warehouse_operator' && 
             'warehouseIds' in userData &&
             userData.warehouseIds is list && 
             warehouseId in userData.warehouseIds;
    }
    
    // --- Fallback rule for secure multi-tenancy ---
    // This rule provides a base level of multi-tenant security for any collection.
    // It allows read/write access only if the document's companyId matches the user's companyId.
    match /{path=**}/{docId} {
        allow read, write: if isSignedIn() && 
                            'companyId' in resource.data && 
                            resource.data.companyId == getUserData(request.auth.uid).companyId;
    }

    // --- Collection Rules (more specific rules override the fallback) ---

    // Users can manage other users within the same company if they are an Admin.
    match /users/{userId} {
      allow read: if isSignedIn() && (
        request.auth.uid == userId ||
        (isAdmin(request.auth.uid) && isSameCompanyAsUser(resource.data.companyId))
      );
      allow list: if isAdmin(request.auth.uid) && isSameCompanyAsUser(request.query.companyId);
      allow create: if isAdmin(request.auth.uid) && isSameCompanyAsUser(request.resource.data.companyId);
      allow update: if isAdmin(request.auth.uid) && 
                      isSameCompanyAsUser(request.resource.data.companyId) &&
                      // Prevent an admin from promoting themselves to super_admin
                      !(request.auth.uid == userId && 
                        resource.data.role == 'admin' && 
                        request.resource.data.role == 'super_admin');
      allow delete: if false; // Soft deletes are enforced via `isActive` flag.
    }

    // Admins can read their company doc, only Super Admins can manage companies.
    match /companies/{companyId} {
      allow read: if isSameCompanyAsUser(companyId);
      allow write: if isSuperAdmin(request.auth.uid);
    }
    
    // Admins or assigned client viewers can access client data.
    match /clients/{clientId} {
       allow get: if isSameCompanyAsUser(resource.data.companyId) || isClientViewerForClient(clientId);
       allow list: if isSameCompanyAsUser(request.query.companyId);
       allow write: if isAdmin(request.auth.uid) && isSameCompanyAsUser(request.resource.data.companyId);
    }

    // Admins or assigned warehouse staff can access warehouse data.
    match /warehouses/{warehouseId} {
      allow get: if isSameCompanyAsUser(resource.data.companyId) || isWarehouseOperatorForWarehouse(warehouseId);
      allow list: if isSameCompanyAsUser(request.query.companyId);
      allow write: if isAdmin(request.auth.uid) && isSameCompanyAsUser(request.resource.data.companyId);
    }
    
    // Company members can access products within their company.
    match /products/{productId} {
      allow read: if isSameCompanyAsUser(request.query.companyId); // For list
      allow get: if isSameCompanyAsUser(resource.data.companyId); // For get
      allow write: if isAdmin(request.auth.uid) && isSameCompanyAsUser(request.resource.data.companyId);
    }

    // Granular access to orders and their events.
    match /orders/{orderId} {
      allow get: if isSameCompanyAsUser(resource.data.companyId) || isClientViewerForClient(resource.data.clientId);
      allow list: if isSameCompanyAsUser(request.query.companyId) || 
                     (isClientViewerForClient(request.query.clientId) && request.query.companyId == getUserData(request.auth.uid).companyId);
      allow create: if 
        (isAdmin(request.auth.uid) && isSameCompanyAsUser(request.resource.data.companyId)) ||
        (isWarehouseOperatorForWarehouse(request.resource.data.warehouseId) && isSameCompanyAsUser(request.resource.data.companyId));
      allow update: if
        (isAdmin(request.auth.uid) && isSameCompanyAsUser(request.resource.data.companyId)) ||
        (
          isWarehouseOperatorForWarehouse(request.resource.data.warehouseId) &&
          isSameCompanyAsUser(request.resource.data.companyId) &&
          // Ensure critical fields are not changed on update
          request.resource.data.companyId == resource.data.companyId &&
          request.resource.data.clientId == resource.data.clientId
        );
      allow delete: if false;
      
      match /events/{eventId} {
        allow read: if isSameCompanyAsUser(get(/databases/$(database)/documents/orders/$(orderId)).data.companyId) || isClientViewerForClient(get(/databases/$(database)/documents/orders/$(orderId)).data.clientId);
        allow create: if isSameCompanyAsUser(request.resource.data.companyId) &&
                         (isAdmin(request.auth.uid) || isWarehouseOperatorForWarehouse(get(/databases/$(database)/documents/orders/$(orderId)).data.warehouseId)) &&
                         request.resource.data.companyId == get(/databases/$(database)/documents/orders/$(orderId)).data.companyId;
        allow update, delete: if false;
      }
    }
    
    // Admins or assigned warehouse operators can manage inventory.
    match /inventory_balances/{balanceId} {
      allow get: if isSameCompanyAsUser(resource.data.companyId) || isWarehouseOperatorForWarehouse(resource.data.warehouseId);
      allow list: if isSameCompanyAsUser(request.query.companyId);
      allow create: if (isAdmin(request.auth.uid) && isSameCompanyAsUser(request.resource.data.companyId)) ||
                       (isWarehouseOperatorForWarehouse(request.resource.data.warehouseId) && isSameCompanyAsUser(request.resource.data.companyId));
      allow update: if (isAdmin(request.auth.uid) && isSameCompanyAsUser(request.resource.data.companyId)) ||
                       (isWarehouseOperatorForWarehouse(request.resource.data.warehouseId) && isSameCompanyAsUser(request.resource.data.companyId) && request.resource.data.companyId == resource.data.companyId);
      allow delete: if false;
    }
    
    match /inventory_ledger/{ledgerId} {
      allow get: if isSameCompanyAsUser(resource.data.companyId) || isWarehouseOperatorForWarehouse(resource.data.warehouseId);
      allow list: if isSameCompanyAsUser(request.query.companyId);
      allow create: if (isAdmin(request.auth.uid) && isSameCompanyAsUser(request.resource.data.companyId)) ||
                       (isWarehouseOperatorForWarehouse(request.resource.data.warehouseId) && isSameCompanyAsUser(request.resource.data.companyId));
      allow update: if false;
      allow delete: if false;
    }
  }
}
