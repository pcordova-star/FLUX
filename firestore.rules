rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data;
    }

    function isSuperAdmin(userId) {
      let userData = getUserData(userId);
      return isSignedIn() && userData.role == 'super_admin';
    }

    function isAdmin(userId) {
      let userRole = getUserData(userId).role;
      return isSignedIn() && (userRole == 'admin' || userRole == 'super_admin');
    }

    function isSameCompanyAsUser(companyId) {
      return isSignedIn() && getUserData(request.auth.uid).companyId == companyId;
    }

    function isClientViewerForClient(clientId) {
      let userData = getUserData(request.auth.uid);
      return isSignedIn() && userData.role == 'client_viewer' && userData.clientId == clientId;
    }

    function isWarehouseOperatorForWarehouse(warehouseId) {
      let userData = getUserData(request.auth.uid);
      // Ensure warehouseIds is a list before checking for presence
      return isSignedIn() && 
             userData.role == 'warehouse_operator' && 
             'warehouseIds' in userData &&
             userData.warehouseIds is list && 
             warehouseId in userData.warehouseIds;
    }

    // --- Collection Rules ---

    // Users can read their own data. Admins/Super Admins can read users in the same company.
    // Admins/Super Admins can create/update users in the same company.
    // An admin cannot make themselves a super_admin.
    match /users/{userId} {
      allow read: if isSignedIn() && (
        request.auth.uid == userId ||
        (isAdmin(request.auth.uid) && isSameCompanyAsUser(resource.data.companyId))
      );
      allow create: if isAdmin(request.auth.uid) && isSameCompanyAsUser(request.resource.data.companyId);
      allow update: if isAdmin(request.auth.uid) && 
                      isSameCompanyAsUser(request.resource.data.companyId) &&
                      // Prevent an admin from promoting themselves to super_admin
                      !(request.auth.uid == userId && 
                        resource.data.role == 'admin' && 
                        request.resource.data.role == 'super_admin');
    }

    // Admins can read their company doc, only Super Admins can write to any company doc.
    match /companies/{companyId} {
      allow read: if isSameCompanyAsUser(companyId);
      allow write: if isSuperAdmin(request.auth.uid);
    }
    
    // Admins of the company or assigned client viewers can read client data.
    // Only admins can write.
    match /clients/{clientId} {
       allow read: if isSameCompanyAsUser(resource.data.companyId) || isClientViewerForClient(clientId);
       allow write: if isAdmin(request.auth.uid) && isSameCompanyAsUser(request.resource.data.companyId);
    }

    // Admins or assigned warehouse staff can read warehouse data.
    // Only admins can write.
    match /warehouses/{warehouseId} {
      allow read: if isSameCompanyAsUser(resource.data.companyId) || isWarehouseOperatorForWarehouse(warehouseId);
      allow write: if isAdmin(request.auth.uid) && isSameCompanyAsUser(request.resource.data.companyId);
    }
    
    // Admins of the company can read products.
    match /products/{productId} {
      allow read: if isSameCompanyAsUser(resource.data.companyId);
      allow write: if isAdmin(request.auth.uid) && isSameCompanyAsUser(request.resource.data.companyId);
    }

    // Admins/Super Admins, or a client viewer for the specific client can read orders.
    // Admins/Super Admins or an assigned warehouse operator can write to orders.
    match /orders/{orderId} {
      allow read: if isSameCompanyAsUser(resource.data.companyId) || isClientViewerForClient(resource.data.clientId);
      allow write: if (isAdmin(request.auth.uid) && isSameCompanyAsUser(request.resource.data.companyId)) ||
                      (isWarehouseOperatorForWarehouse(request.resource.data.warehouseId) && isSameCompanyAsUser(request.resource.data.companyId));
    }
    
    // Admins or assigned warehouse operators can read/write inventory balances.
    match /inventory_balances/{balanceId} {
      allow read: if isSameCompanyAsUser(resource.data.companyId);
      allow write: if (isAdmin(request.auth.uid) && isSameCompanyAsUser(request.resource.data.companyId)) ||
                      (isWarehouseOperatorForWarehouse(request.resource.data.warehouseId) && isSameCompanyAsUser(request.resource.data.companyId));
    }
    
    // Admins or assigned warehouse operators can read/write inventory ledger.
    match /inventory_ledger/{ledgerId} {
      allow read: if isSameCompanyAsUser(resource.data.companyId);
      allow write: if (isAdmin(request.auth.uid) && isSameCompanyAsUser(request.resource.data.companyId)) ||
                      (isWarehouseOperatorForWarehouse(request.resource.data.warehouseId) && isSameCompanyAsUser(request.resource.data.companyId));
    }

    // Fallback rule for any other collection that has a companyId field.
    // This provides a base level of multi-tenant security.
    match /{document=**} {
      allow read, delete: if isSignedIn() && isSameCompanyAsUser(resource.data.companyId);
      allow create, update: if isSignedIn() && isSameCompanyAsUser(request.resource.data.companyId);
    }
  }
}