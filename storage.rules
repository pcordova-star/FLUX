rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData(userId) {
      return get(/databases/(default)/documents/users/$(userId)).data;
    }
    
    function getOrderData(orderId) {
      return get(/databases/(default)/documents/orders/$(orderId)).data;
    }

    function isUserCompany(companyId) {
      return isSignedIn() && getUserData(request.auth.uid).companyId == companyId;
    }
    
    function isClientViewerForClient(clientId) {
      let userData = getUserData(request.auth.uid);
      return isSignedIn() && 
             userData.role == 'client_viewer' && 
             userData.clientId == clientId;
    }

    // --- Rules ---

    // Deny all reads and writes by default
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Allow read/write on evidence files for authorized users.
    // - Company users can read/write if they belong to the same company as the evidence.
    // - Client viewers can ONLY read if the order is associated with their client ID.
    match /evidence/{companyId}/{orderId}/{fileName} {
      allow read: if isSignedIn() &&
                    getOrderData(orderId) != null &&
                    getOrderData(orderId).companyId == companyId &&
                    (
                      isUserCompany(companyId) ||
                      isClientViewerForClient(getOrderData(orderId).clientId)
                    );
      allow write: if isSignedIn() &&
                     getOrderData(orderId) != null &&
                     getOrderData(orderId).companyId == companyId &&
                     isUserCompany(companyId);
    }
  }
}
