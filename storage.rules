rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData(userId) {
      return get(/databases/(default)/documents/users/$(userId)).data;
    }
    
    function getOrderData(orderId) {
      return get(/databases/(default)/documents/orders/$(orderId)).data;
    }

    function isUserCompany(companyId) {
      return isSignedIn() && getUserData(request.auth.uid).companyId == companyId;
    }

    function isClientViewerForOrder(orderId) {
      let userData = getUserData(request.auth.uid);
      let orderData = getOrderData(orderId);
      return isSignedIn() && 
             userData.role == 'client_viewer' && 
             userData.clientId == orderData.clientId;
    }

    // --- Rules ---

    // Deny all reads and writes by default
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Allow read/write on evidence files only for authorized users of that company,
    // or for a client viewer if the order belongs to them.
    match /evidence/{companyId}/{orderId}/{fileName} {
      allow read, write: if isSignedIn() && 
                           isUserCompany(companyId) &&
                           (getOrderData(orderId) != null); // Ensure order exists
                           
      allow read: if isClientViewerForOrder(orderId);
    }
  }
}